# ==============================================================================
# SISTEM INFORMASI AKADEMIK & WEBSITE SEKOLAH (SIAS)
# Konfigurasi Lingkungan (.env)
# ==============================================================================

APP_NAME="Website Sekolah & Sistem Raport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# PENGATURAN DATABASE
# Pilihan 1: SQLite (Default Development)
# Pilihan 2: MySQL (Rekomendasi Produksi)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=db_sekolah
# DB_USERNAME=root
# DB_PASSWORD=

# ------------------------------------------------------------------------------
# SESSION, CACHE & QUEUE
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ------------------------------------------------------------------------------
# PENGATURAN EMAIL (Notifikasi & Reset Password)
# Ganti dengan SMTP Gmail/Mailtrap/Hosting jika sudah produksi
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# ASSETS & FRONTEND
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
